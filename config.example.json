{
  "project_root": ".",
  "llm": {
    "provider": "deepseek",
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-flash",
    "max_tokens": 8192,
    "json_repairs": 2,
    "api_retries": 2,
    "api_retry_backoff_sec": 2.0,
    "request_timeout_sec": 2400,
    "thinking": "low",
    "thinking_by_stage": {
      "novel-bible": "high",
      "novel-episodes": "high",
      "novel-script": "high",
      "novel-board-prompts": "disabled"
    },
    "stream": true,
    "stream_idle_timeout_sec": 180,
    "parallel": 3,
    "prompt_parallel": 4,
    "story_source_chars": 30000,
    "story_chars_per_episode": 9000,
    "story_max_auto_episodes": 12,
    "story_chapters_per_episode": 0,
    "story_plot_mode": true,
    "story_plot_atom_chars": 2400,
    "story_plot_atom_excerpt": 900,
    "story_plot_max_atoms": 180,
    "story_plot_total_chars": 100000,
    "story_plot_prefix_chars_per_episode": 5000,
    "story_plot_episode_batch": 3,
    "story_volume_chapters": 5,
    "story_fallback_chunk": 20000,
    "story_fallback_overlap": 500,
    "story_max_volumes": 60,
    "story_episode_batch": 10,
    "story_gate_attempts": 3
  },
  "story": {
    "prompt_language": "en",
    "chars_per_second": 4.5,
    "action_seconds": 2.5,
    "tolerance": 0.15,
    "max_line_chars": 18,
    "min_shot_seconds": 1.0,
    "max_shot_seconds": 3.2,
    "max_segment_seconds": 15.0,
    "max_faces_per_shot": null,
    "max_lines_per_shot": null,
    "no_face_chars": [],
    "narration_mode": "auto",
    "narration_max_exposition": 2,
    "narration_max_inner": 3,
    "transition_mode": "auto"
  }
}
